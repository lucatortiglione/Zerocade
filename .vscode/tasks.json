{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Prompt: raccogli e inserisci inventario da tutte le fonti registrate",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_inventory.py", "collect"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Prompt: stato dell'inventario raccolto",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_inventory.py", "status"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Fonti: cerca aggiornamenti e prepara il confronto",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "check-updates", "--only", "${input:updateSource}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Fonti: elenca aggiornamenti e decisioni",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "updates"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Fonti: mostra differenze di un aggiornamento",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "changes", "${input:updateId}", "--kind", "${input:changeKind}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Fonti: integra, scarta o rimanda un aggiornamento",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "decide-update", "${input:updateId}", "--decision", "${input:updateDecision}", "--reason", "${input:decisionReason}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Voci: integra, scarta o rimanda una parola",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "decide-term", "${input:inventoryPrompt}", "--decision", "${input:termDecision}", "--reason", "${input:decisionReason}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Voci: mostra scheda e storico di una parola",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "term", "${input:inventoryPrompt}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Database: backup completo con inventario e decisioni",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "inventory_updates.py", "backup"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Prompt: importa solo bacini già revisionati",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_database.py", "import-reviewed", "${input:reviewedPools}"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Livecade: genera lista (7 risposte per prompt)",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_database.py", "livecade", "--count", "${input:promptCount}", "--seed", "${input:wordSeed}", "--format", "csv"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Prompt: aggiorna prompt.sql dal database",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_database.py", "dump"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    },
    {
      "label": "Prompt: stato e integrità del DB",
      "type": "process",
      "command": "${workspaceFolder}/gioco-zeroassociations/.venv/Scripts/python.exe",
      "args": ["-B", "prompt_database.py", "status"],
      "options": {"cwd": "${workspaceFolder}/gioco-zeroassociations"},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id":"updateSource","type":"promptString","description":"ID della fonte da controllare, oppure * per tutte le fonti del database","default":"*"},
    {"id":"updateId","type":"promptString","description":"ID aggiornamento o prefisso univoco di almeno 8 caratteri"},
    {"id":"changeKind","type":"pickString","description":"Voci da mostrare (prime 50)","options":["NEW","CHANGED","REMOVED","UNCHANGED"],"default":"NEW"},
    {"id":"updateDecision","type":"pickString","description":"Decisione sull'intero aggiornamento: integra, scarta o rimanda","options":["DEFER","APPLY","DISCARD"],"default":"DEFER"},
    {"id":"inventoryPrompt","type":"promptString","description":"Parola esatta da cercare o gestire"},
    {"id":"termDecision","type":"pickString","description":"Decisione sulla parola nell'inventario (non approvazione delle associazioni)","options":["DEFERRED","INTEGRATED","DISCARDED"],"default":"DEFERRED"},
    {"id":"decisionReason","type":"promptString","description":"Motivazione della decisione, conservata nello storico"},
    {"id": "promptCount", "type": "promptString", "description": "Numero di prompt distinti da estrarre per Livecade (7 risposte ciascuno)", "default": "50"},
    {"id": "wordSeed", "type": "promptString", "description": "Seed riproducibile; vuoto per una nuova estrazione casuale", "default": ""},
    {"id": "reviewedPools", "type": "promptString", "description": "JSONL di bacini verificati semanticamente prima dell'importazione", "default": "resources/prompt_pools_reviewed_20261109.jsonl"}
  ]
}
